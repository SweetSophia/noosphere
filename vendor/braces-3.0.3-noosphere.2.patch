--- upstream/lib/nesting.js
+++ candidate/lib/nesting.js
@@ -0,0 +1,46 @@
+'use strict';
+
+// Fixed local-fork limits, not caller-controlled options. Parsed trees contain
+// a root, up to MAX_NESTING containers, and a final leaf node.
+const MAX_NESTING = 64;
+const MAX_AST_DEPTH = MAX_NESTING + 1;
+
+// Object inputs bypass parse(). Check their child edges iteratively before any
+// recursive consumer runs. Parser-generated parent/prev backlinks are not child
+// edges; checking them here would incorrectly reject ordinary parsed trees.
+const assertAstBudget = ast => {
+  const active = new WeakSet();
+  const stack = [];
+
+  const enter = (node, depth) => {
+    if (!node || typeof node !== 'object') {
+      throw new TypeError('Expected an AST node');
+    }
+    if (depth > MAX_AST_DEPTH) {
+      throw new SyntaxError('AST nesting exceeds maximum depth (65)');
+    }
+    if (active.has(node)) {
+      throw new SyntaxError('Cyclic AST child nodes are not supported');
+    }
+    const children = node.nodes;
+    if (!children) return;
+    if (!Array.isArray(children)) {
+      throw new TypeError('Expected AST nodes to be an array');
+    }
+    active.add(node);
+    stack.push({ node, depth, children, index: 0 });
+  };
+
+  enter(ast, 0);
+  while (stack.length > 0) {
+    const frame = stack[stack.length - 1];
+    if (frame.index === frame.children.length) {
+      active.delete(frame.node);
+      stack.pop();
+    } else {
+      enter(frame.children[frame.index++], frame.depth + 1);
+    }
+  }
+};
+
+module.exports = { MAX_NESTING, MAX_AST_DEPTH, assertAstBudget };
